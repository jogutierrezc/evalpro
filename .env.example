# ═══════════════════════════════════════════════════
#  EvalPro UDES — Variables de Entorno
# ═══════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores
# cp .env.example .env
# ═══════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────
# Frontend (expuesto al navegador, RLS activo)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Service Role (solo backend/scripts, brinca RLS — NO exponer al frontend)
# Obtener en: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (correos transaccionales) ─────────────
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EVALUACIONES=evaluaciones@tudominio.com

# Webhook de Resend para tracking de entregas (opcional)
# Configurar en: Resend Dashboard > Webhooks
RESEND_WEBHOOK_SECRET=

# ── Cron / Automatización ───────────────────────
# Secreto para proteger el endpoint de notificaciones automáticas (CRON de Vercel)
# Puede ser cualquier string aleatorio: openssl rand -hex 32
CRON_SECRET=

# ── Opcionales: IA para reportes ────────────────
# VITE_OPENROUTER_API_KEY=
# VITE_OPENROUTER_MODEL=openrouter/auto
# VITE_GOOGLE_AI_KEY=
# VITE_SITE_URL=http://localhost:5173
# VITE_SITE_NAME=EvalPro UDES
